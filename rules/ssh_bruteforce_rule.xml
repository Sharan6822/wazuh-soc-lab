<!-- Custom Wazuh rule: SSH brute-force detection
     Place inside a <group> block in /var/ossec/etc/rules/local_rules.xml
     on the Wazuh manager, then run: sudo systemctl restart wazuh-manager

     Rule 5760 is Wazuh's built-in "sshd: authentication failed" rule.
     This rule fires when 5760 triggers 5 times within 120 seconds. -->
<group name="local,syslog,sshd,">
  <rule id="100002" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <description>SSH brute-force attack detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_11.4,mitre,</group>
  </rule>
</group>